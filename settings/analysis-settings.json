{
  "workflow": "scrna-seq",
  "workflow_version": "1.0.0",
  "random_seed": 42,
  "lab_run_time": "12 min 13 s (import from CELLxGENE: 20 s)",
  "parameters": {
    "import": {
      "sample_column": null,
      "max_cells": null
    },
    "qc": {
      "threshold_mode": "mad",
      "nmads": 5,
      "nmads_mt": 3,
      "max_pct_mt": 20,
      "min_genes": 200,
      "max_genes": null,
      "min_counts": null,
      "max_counts": null,
      "doublet_method": "scrublet",
      "remove_doublets": true,
      "expected_doublet_rate": null,
      "min_cells_per_gene": 3
    },
    "normalisation": {
      "method": "lognorm",
      "n_top_genes": 2000,
      "target_sum": 10000,
      "hvg_per_sample": true,
      "regress_out": [],
      "scale_max": 10
    },
    "dimensionality_reduction": {
      "n_pcs": 30,
      "n_neighbors": 15,
      "umap_min_dist": 0.5,
